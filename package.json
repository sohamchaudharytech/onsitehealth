{
  "name": "onsitehackathon",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Clinical Reference-Data Consistency for Alert Generation",
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "build:all": "npm run build && npm run build -w dashboard && npm --prefix dashboard-logistics run build",
    "typecheck:all": "npm run typecheck && npm run build -w dashboard && npm --prefix dashboard-logistics run build",
    "test": "npm run build && node --test tests/*.test.ts",
    "start:central": "node services/central-reference-service/dist/index.js",
    "start:coordinator": "node services/convergence-coordinator/dist/index.js",
    "start:site": "node services/site-agent/dist/index.js",
    "start:dashboard": "cd dashboard && npm run dev",
    "demo": "node scripts/demo.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "workspaces": [
    "services/*",
    "shared",
    "dashboard",
    "dashboard-logistics"
  ],
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "ws": "^8.21.3"
  }
}
