FROM node:22-slim
WORKDIR /app
COPY package*.json tsconfig*.json ./
COPY shared/package.json shared/
COPY services/central-reference-service/package.json services/central-reference-service/
COPY services/convergence-coordinator/package.json services/convergence-coordinator/
COPY services/site-agent/package.json services/site-agent/
RUN npm install
COPY shared shared
COPY services services
EXPOSE 4001 4002 4101 4102 4103
